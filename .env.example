# Copy to .env and fill in. .env is gitignored; never commit real values.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional same-provider model overrides. Defaults favor interactive latency.
# TAG_MODEL=gemini-3.5-flash-lite
# AUTOCOMPLETE_MODEL=gemini-3.5-flash-lite
# GENERATE_MODEL=gemini-3.5-flash-lite
# For the stronger full-suggestion model: GENERATE_MODEL=gemini-3.6-flash
# FAST_AUTOCOMPLETE_ENABLED=false restores serial semantic retrieval for comparisons.

# Tiger Data service connection string (Tiger Cloud console → Connect)
# e.g. postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL= 

# Snowflake: name of a connection in ~/.snowflake/connections.toml (created with `snow connection add`)
SNOWFLAKE_CONNECTION_NAME=prompt-enhance
