# Copy to .env and fill in. .env is gitignored; never commit real values.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional same-provider model overrides. Defaults favor interactive latency.
# TAG_MODEL=gemini-3.5-flash-lite
# AUTOCOMPLETE_MODEL=gemini-3.5-flash-lite
# GENERATE_MODEL=gemini-3.5-flash-lite
# For the stronger full-suggestion model: GENERATE_MODEL=gemini-3.6-flash
# Small catalogs are reviewed in full so broadly applicable workflow guidance is not
# lost to keyword/vector shortlists. Full source bodies are bounded to 64 items/80k chars.
# CATALOG_REVIEW_ENABLED=false restores shortlist-based routing for comparisons.
# DIRECT_SEMANTIC_ENABLED=false disables the paired document/query embedding index.
# Direct semantics replaces the slow fallback; existing lexical matches stay fast.
# SEMANTIC_FIRST_ENABLED=true uses semantic nomination for every eligible prompt.
# That improved fixture recall but added latency in the browser benchmark.
# Default semantic embeddings run locally using Google's EmbeddingGemma 2.
# Install with: cd backend && uv sync --extra local-retrieval
# Then run: uv run --extra local-retrieval python scripts/setup_local_embeddings.py
# LOCAL_EMBEDDING_MODEL_DIR=/absolute/path/to/model
# SEMANTIC_EMBED_BACKEND=gemini instead sends document/query text to the Gemini embedding API.
# Set CATALOG_REVIEW_ENABLED=false, DIRECT_SEMANTIC_ENABLED=false and FAST_AUTOCOMPLETE_ENABLED=false
# to restore serial tag-based semantic retrieval for comparisons.

# Tiger Data service connection string (Tiger Cloud console → Connect)
# e.g. postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL= 

# Snowflake: name of a connection in ~/.snowflake/connections.toml (created with `snow connection add`)
SNOWFLAKE_CONNECTION_NAME=prompt-enhance
