# Copy to .env and fill in. .env is gitignored; never commit real values.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tiger Data service connection string (Tiger Cloud console → Connect)
# e.g. postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL= 

# Snowflake: name of a connection in ~/.snowflake/connections.toml (created with `snow connection add`)
SNOWFLAKE_CONNECTION_NAME=prompt-enhance
