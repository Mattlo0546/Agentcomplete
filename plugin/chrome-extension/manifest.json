{
  "manifest_version": 3,
  "name": "Prompt Enhance for ChatGPT",
  "version": "0.4.2",
  "description": "The Prompt Enhance webapp in ChatGPT: refine prompts, manage knowledge, review activity and save versions.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Skill Issue"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "dist/workspace-host.js",
        "native-autocomplete.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
